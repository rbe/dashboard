# The Makefile of a Node project on project.mk, from the template of
# the node skill. .prettierignore and eslint.config.mjs come from the
# same skill.
#
# Node and npm run through $(NODE), which is Podman on this machine.
# Prettier is the formatter. ESLint is the linter. The test runner is
# node --test. A project with no artifact to build or no integration
# entry sets that command to `true`.
#
# A new project, or a project with no Prettier and no ESLint yet, runs
#   make node-tooling
# once. It creates package.json, adds the dev tools, writes the config
# files, and formats the project. A file or a dependency that is
# already there stays as it is. NAME sets the package name and NODE_DEV_TOOLS
# the dev tools, for example: make node-tooling NAME=my-app
# A library names what it ships, so that make build packs nothing else:
#   make npm ARGS='pkg set exports=./src/index.js files[0]=src'
#
# coverage and test-changed fail until the first unit test exists.

NODE_VERSION ?= 24
NODE_IMAGE ?= docker.io/library/node:$(NODE_VERSION)-bookworm-slim
# The dev tools of node-tooling. NAME, the package name of a new project,
# comes from project.mk: the repository name of the remote origin, else
# the directory name.
NODE_DEV_TOOLS ?= prettier eslint @eslint/js globals
NODE = podman run --rm $(PYTHON_USERNS) --user $(PYTHON_UID):$(PYTHON_GID) -e HOME=/tmp -e CI \
	-e NODE_V8_COVERAGE -e npm_config_cache=/tmp/npm-cache \
	-e npm_config_update_notifier=false -v "$(CURDIR)":/work:Z -w /work $(NODE_IMAGE)

UNIT_TESTS = "test/unit/*.test.js"
INTEGRATION_TESTS = "test/integration/*.test.js"

SETUP_CMD = $(NODE) npm ci
BUILD_CMD = mkdir -p build && $(NODE) npm pack --pack-destination build
TEST_CMD = $(NODE) node --test $(UNIT_TESTS)
INTEGRATION_CMD = $(NODE) node --test $(INTEGRATION_TESTS)
# A fresh checkout has no node_modules. The tools run from the locked
# dev dependencies, so these three commands install them first.
NODE_DEPS = if [ ! -d node_modules ] && [ -f package-lock.json ]; then $(NODE) npm ci; fi
FORMAT_CMD = $(NODE_DEPS) && $(NODE) npm exec -- prettier --check .
FORMAT_FIX_CMD = $(NODE_DEPS) && $(NODE) npm exec -- prettier --write .
LINT_CMD = $(NODE_DEPS) && $(NODE) npm exec -- eslint .
COVERAGE_CMD = set -eu; \
	base=$$(git merge-base HEAD origin/$(DEFAULT_BRANCH) 2>/dev/null || git merge-base HEAD $(DEFAULT_BRANCH) 2>/dev/null || git rev-parse -q --verify HEAD 2>/dev/null || git hash-object -t tree /dev/null); \
	git add -N .; \
	git diff "$$base" > build/coverage/change.diff; \
	NODE_V8_COVERAGE=/work/build/coverage/v8 $(NODE) node --test --experimental-test-coverage \
	  --test-reporter=lcov --test-reporter-destination=build/coverage/lcov.info $(UNIT_TESTS); \
	$(PYTHON) .claude/skills/project-report/scripts/node_cover_map.py; \
	REPORT=build/coverage/lcov.info $(DIFF_COVER)
TEST_CHANGED_CMD = chosen=$$($(PYTHON) .claude/skills/project-report/scripts/changed_tests.py --print) || exit 1; \
	chosen=$$(printf '%s' "$$chosen" | tr '\n' ' '); \
	if [ -z "$$chosen" ]; then printf '%s\n' "test-changed: no test covers the changed files. make test runs the full suite."; \
	else printf 'test-changed: %s\n' "$$chosen"; $(NODE) node --test $$chosen; fi

include .claude/skills/project-setup/project.mk

# Project targets.

.PHONY: npm
npm: ## Run npm in Podman on this machine. Set ARGS.
	@set -eu; \
	if [ -z "$(ARGS)" ]; then printf '%s\n' "npm: set ARGS to the npm arguments." >&2; exit 1; fi
	$(NODE) npm $(ARGS)

# One target for the Node tooling, every step through Podman:
# 1. package.json (npm init, name, version, type=module) when missing
# 2. NODE_DEV_TOOLS as exact devDependencies, each one not yet there
# 3. .prettierignore and eslint.config.mjs from the node skill, and
#    .editorconfig from project-setup, each one when missing
# 4. node_modules/ and coverage/ in .gitignore, each line when missing
# 5. make format-fix, so make format passes from the first commit
# A file or a dependency already in the project stays as it is.
.PHONY: node-tooling
node-tooling: ## Set up package.json, Prettier, ESLint, and EditorConfig, then format
	@set -eu; \
	if [ ! -f package.json ]; then \
	  $(NODE) npm init -y; \
	  $(NODE) npm pkg set name=$(NAME) version=0.1.0 type=module; \
	  $(NODE) npm pkg delete main repository scripts; \
	fi; \
	missing=""; \
	for tool in $(NODE_DEV_TOOLS); do \
	  if ! grep -q "\"$$tool\":" package.json; then missing="$$missing $$tool"; fi; \
	done; \
	if [ -n "$$missing" ]; then $(NODE) npm install --save-dev --save-exact $$missing; \
	else echo "node-tooling: $(NODE_DEV_TOOLS) already in package.json"; fi; \
	if [ ! -f .prettierignore ]; then cp .claude/skills/node/templates/prettierignore .prettierignore; fi; \
	if [ ! -f eslint.config.mjs ]; then cp .claude/skills/node/templates/eslint.config.mjs eslint.config.mjs; fi; \
	if [ ! -f .editorconfig ]; then cp .claude/skills/project-setup/templates/editorconfig .editorconfig; fi; \
	touch .gitignore; \
	for line in node_modules/ coverage/; do \
	  if ! grep -qx "$$line" .gitignore; then printf '%s\n' "$$line" >> .gitignore; fi; \
	done; \
	$(MAKE) --no-print-directory format-fix
