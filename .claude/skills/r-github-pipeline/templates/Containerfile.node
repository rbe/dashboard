# Node app image. The image copies named files, not the work tree.
# Change the paths src/ and dist/ and the start command to the ones
# this project uses. make image passes NODE_VERSION.
ARG NODE_VERSION=24

FROM docker.io/library/node:${NODE_VERSION}-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY src/ src/
RUN npm run build

FROM docker.io/library/node:${NODE_VERSION}-bookworm-slim
WORKDIR /app
ENV NODE_ENV=production
COPY package.json package-lock.json ./
RUN npm ci --omit=dev
COPY --from=build /app/dist/ dist/
USER node
CMD ["node", "dist/server.js"]
