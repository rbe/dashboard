# Node app delivered as a container image.
# Make contract: r-project-setup. help is the default goal. The target
# names are setup, build, test, editorconfig, format, format-fix, lint,
# integration, coverage, docs, and login. This makefile sets the command
# variables of the contract and defines none of those targets again.
# npm, Podman, python, and tar run inside the commands.
# GitHub makefile: set the product values and the command variables, and
# include sdlc.mk from the installed skill before any target. sdlc.mk
# already defines help, so leave project.mk out. sdlc.mk adds the
# contract targets, the image targets, version, publish tags, cleanup,
# and report.

NAME ?= app
OWNER ?= owner
IMAGE_NAME ?= ghcr.io/$(OWNER)/$(NAME)
IMAGE ?= $(IMAGE_NAME)
PACKAGE ?= $(OWNER)/$(NAME)
KEEP_VERSIONS ?= 2

NODE_VERSION ?= 24
NODE_IMAGE ?= docker.io/library/node:$(NODE_VERSION)-bookworm-slim
CI_IMAGE ?= localhost/$(NAME):ci
PORT ?= 4173
# curl runs in this image for the smoke check of make build. It joins
# the network of the smoke container, so no port of the host is used.
CURL_IMAGE ?= docker.io/curlimages/curl:8.17.0
SMOKE_PATH ?= /api/health
SMOKE_NEEDLE ?= ok
DATA_DIR ?= data
DATA_ENV ?= APP_DATA

NODE_RUN = podman run --rm -e HOME=/tmp -e CI -e NODE_V8_COVERAGE -e npm_config_cache=/tmp/npm-cache \
	-e npm_config_update_notifier=false -v "$(CURDIR)":/work:Z -w /work $(NODE_IMAGE)
# The jobs after setup unpack the dependencies that setup packed.
NODE_DEPS = if [ ! -d node_modules ]; then tar -xf build/deps/node_modules.tar; fi

# The command variables of the contract. A # inside one is written \#.
SETUP_CMD = set -eu; \
	mkdir -p build/deps build/summaries; \
	if [ ! -d node_modules ]; then $(NODE_RUN) npm ci; fi; \
	$(NODE_RUN) sh -c 'npm audit --audit-level=high || echo "npm audit reported advisories; continuing"'; \
	tar -cf build/deps/node_modules.tar node_modules; \
	printf '\# setup\n\nNode %s. Dependencies packed.\n' "$(NODE_VERSION)" > build/summaries/setup.md
BUILD_CMD = set -eu; \
	$(NODE_DEPS); \
	$(NODE_RUN) npm run build; \
	$(THIS_MAKE) --no-print-directory image-ci
TEST_CMD = set -eu; \
	$(NODE_DEPS); \
	mkdir -p build/summaries; \
	$(NODE_RUN) npm test; \
	printf '\# test\n\nnpm test.\n' > build/summaries/test.md
FORMAT_CMD = $(NODE_RUN) npm exec -- prettier --check .
FORMAT_FIX_CMD = $(NODE_RUN) npm exec -- prettier --write .
LINT_CMD = $(NODE_RUN) npm exec -- eslint .
INTEGRATION_CMD = $(NODE_RUN) npm run integration
# The coverage map works with node --test and with Jest. The workers of
# Vitest write no V8 coverage. For Vitest, delete the node_cover_map.py
# line in COVERAGE_CMD and use this line for TEST_CHANGED_CMD:
#   TEST_CHANGED_CMD = $(NODE_RUN) npx vitest related --run $$(cat build/coverage/changed.txt)
COVERAGE_CMD = set -eu; \
	$(NODE_DEPS); \
	NODE_V8_COVERAGE=/work/build/coverage/v8 $(NODE_RUN) npm test -- --coverage; \
	$(PYTHON) .claude/skills/r-project-report/scripts/node_cover_map.py; \
	base=$$(git merge-base HEAD origin/$(DEFAULT_BRANCH) 2>/dev/null || git merge-base HEAD $(DEFAULT_BRANCH) 2>/dev/null || git rev-parse -q --verify HEAD 2>/dev/null || git hash-object -t tree /dev/null); \
	git add -N .; \
	git diff "$$base" > build/coverage/change.diff; \
	report=$$(find . -name lcov.info -o -name coverage.xml | head -n 1); \
	test -n "$$report"; \
	REPORT="$$report" $(DIFF_COVER)
TEST_CHANGED_CMD = chosen=$$($(PYTHON) .claude/skills/r-project-report/scripts/changed_tests.py --print) || exit 1; \
	chosen=$$(printf '%s' "$$chosen" | tr '\n' ' '); \
	if [ -z "$$chosen" ]; then printf '%s\n' "test-changed: no test covers the changed files. make test runs the full suite."; \
	else printf 'test-changed: %s\n' "$$chosen"; $(NODE_RUN) npm test -- $$chosen; fi

# login comes from the contract when PUBLISH_IMAGE is set. The docs target
# stays off, because no skill ships scripts/render-docs.mjs. A repository
# that writes that renderer sets RENDER_DOCS = 1, adds docs to SDLC_JOBS and
# SDLC_CI, and adds a docs job to the workflow.
DOCS_CMD = set -eu; \
	mkdir -p build/docs build/summaries; \
	if find docs -name '*.md' 2>/dev/null | grep -q .; then \
	  $(NODE_RUN) node scripts/render-docs.mjs docs build/docs; \
	fi; \
	printf '\# docs\n\n%s HTML files.\n' "$$(find build/docs -type f | wc -l | tr -d ' ')" > build/summaries/docs.md
PUBLISH_IMAGE = 1
SDLC_JOBS ?= setup build test publish-container
SDLC_CI ?= setup build editorconfig format lint test integration coverage report

# The image targets come from container.mk. make build builds the image,
# runs the smoke check, and saves the image tar.
IMAGE_BUILD_ARGS = --build-arg NODE_VERSION=$(NODE_VERSION)
SMOKE_CMD = name=$(NAME)-smoke; \
	podman rm -f "$$name" >/dev/null 2>&1 || true; \
	podman run -d --name "$$name" -e PORT=$(PORT) "$(CI_IMAGE)" >/dev/null; \
	ok=0; \
	i=0; \
	while [ "$$i" -lt 30 ]; do \
	  if podman run --rm --network "container:$$name" $(CURL_IMAGE) -fsSk "https://127.0.0.1:$(PORT)$(SMOKE_PATH)" 2>/dev/null | grep -qF '$(SMOKE_NEEDLE)'; then ok=1; break; fi; \
	  i=$$((i + 1)); sleep 1; \
	done; \
	podman rm -f "$$name" >/dev/null 2>&1 || true; \
	test "$$ok" = 1

include .claude/skills/r-github-pipeline/sdlc.mk

# Project targets.

.PHONY: run stop clean

run: image ## Run detached on https://127.0.0.1:PORT
	@mkdir -p "$(DATA_DIR)"
	@podman rm -f $(NAME) >/dev/null 2>&1 || true
	podman run -d --name $(NAME) -p 127.0.0.1:$(PORT):$(PORT) -e PORT=$(PORT) \
		-e $(DATA_ENV)=/app/data -v "$(CURDIR)/$(DATA_DIR):/app/data:Z" "$(IMAGE)"

stop: ## Stop the detached container
	@podman rm -f $(NAME) >/dev/null 2>&1 || true

clean: ## Remove build/, dist/, and node_modules/
	rm -rf build dist node_modules
