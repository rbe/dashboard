# The Makefile of a Node project on project.mk, from the template of
# the r-node skill. .prettierignore and eslint.config.mjs come from the
# same skill.
#
# Node and npm run through $(NODE), which is Podman on this machine.
# Prettier is the formatter. ESLint is the linter. The test runner is
# node --test. A project with no artifact to build or no integration
# entry sets that command to `true`.
#
# The targets npm and node-tooling come from node.mk of the r-node
# skill. A new project, or a project with no Prettier and no ESLint yet,
# runs
#   make node-tooling
# once. node.mk has the details.
#
# coverage and test-changed fail until the first unit test exists.

# $(NODE) runs Node and npm in Podman. node.mk of the r-node skill sets
# NODE, NODE_IMAGE, NODE_VERSION, and NODE_DEV_TOOLS. A project that
# needs another value sets the variable before the include of node.mk.

UNIT_TESTS = "test/unit/*.test.js"
INTEGRATION_TESTS = "test/integration/*.test.js"

SETUP_CMD = $(NODE) npm ci
BUILD_CMD = mkdir -p build && $(NODE) npm pack --pack-destination build
TEST_CMD = $(NODE) node --test $(UNIT_TESTS)
INTEGRATION_CMD = $(NODE) node --test $(INTEGRATION_TESTS)
# A fresh checkout has no node_modules. The tools run from the locked
# dev dependencies, so these three commands install them first.
NODE_DEPS = if [ ! -d node_modules ] && [ -f package-lock.json ]; then $(NODE) npm ci; fi
FORMAT_CMD = $(NODE_DEPS) && $(NODE) npm exec -- prettier --check .
FORMAT_FIX_CMD = $(NODE_DEPS) && $(NODE) npm exec -- prettier --write .
LINT_CMD = $(NODE_DEPS) && $(NODE) npm exec -- eslint .
COVERAGE_CMD = set -eu; \
	base=$$(git merge-base HEAD origin/$(DEFAULT_BRANCH) 2>/dev/null || git merge-base HEAD $(DEFAULT_BRANCH) 2>/dev/null || git rev-parse -q --verify HEAD 2>/dev/null || git hash-object -t tree /dev/null); \
	git add -N .; \
	git diff "$$base" > build/coverage/change.diff; \
	NODE_V8_COVERAGE=/work/build/coverage/v8 $(NODE) node --test --experimental-test-coverage \
	  --test-reporter=lcov --test-reporter-destination=build/coverage/lcov.info $(UNIT_TESTS); \
	$(PYTHON) .claude/skills/r-project-report/scripts/node_cover_map.py; \
	REPORT=build/coverage/lcov.info $(DIFF_COVER)
TEST_CHANGED_CMD = chosen=$$($(PYTHON) .claude/skills/r-project-report/scripts/changed_tests.py --print) || exit 1; \
	chosen=$$(printf '%s' "$$chosen" | tr '\n' ' '); \
	if [ -z "$$chosen" ]; then printf '%s\n' "test-changed: no test covers the changed files. make test runs the full suite."; \
	else printf 'test-changed: %s\n' "$$chosen"; $(NODE) node --test $$chosen; fi

include .claude/skills/r-project-setup/project.mk
include .claude/skills/r-node/node.mk

# Project targets.
