{
  "name": "dashboard",
  "version": "1.0.0",
  "description": "Local markdown dashboard for systems and links",
  "type": "module",
  "bin": {
    "dashboard": "server/bin/dashboard.mjs"
  },
  "files": [
    "server/bin/dashboard.mjs",
    "server/cli.mjs",
    "server/server.mjs",
    "server/dashboard-api.mjs",
    "server/tls-cert.mjs",
    "shared/openapi.json",
    "shared/validate.mjs",
    "dist",
    "data/dashboard.example.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rbe/dashboard.git"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "vite --host 127.0.0.1 --port 5173",
    "dev": "vite --host 127.0.0.1 --port 5173",
    "generate": "openapi-typescript shared/openapi.json -o shared/schema.ts",
    "build": "npm run generate && tsc --noEmit && vite build",
    "preview": "npm run build && node server/serve.mjs",
    "dashboard": "node server/bin/dashboard.mjs",
    "package:binary": "npm run build && node scripts/build-binary.mjs",
    "prepack": "npm run build",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "@vitest/coverage-v8": "3.2.7",
    "esbuild": "^0.28.2",
    "happy-dom": "^17.4.4",
    "openapi-typescript": "^7.13.0",
    "postject": "1.0.0-alpha.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.1.4"
  }
}
