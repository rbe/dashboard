{
  "name": "@rbe/dashboard-client",
  "version": "1.0.0",
  "description": "Typed HTTP client for the dashboard API",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rbe/dashboard.git",
    "directory": "client"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "generate": "openapi-typescript ../shared/openapi.json -o ../shared/schema.ts",
    "build": "node build.mjs",
    "prepack": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "esbuild": "^0.28.2",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
